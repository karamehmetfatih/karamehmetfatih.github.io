%  HOW THIS WORKS
%  Add an entry here, then cite its key in publications.qmd.
%  Quarto formats it in The Plant Journal style automatically
%  (assets/the-plant-journal.csl). You never hand-format a
%  reference again.
%
%  FASTEST WAY TO FILL THIS IN
%    ORCID   : orcid.org -> your record -> Works -> Export -> BibTeX
%    Zotero  : select items -> right-click -> Export -> BibTeX
%    Scholar : article -> " -> BibTeX
%  Paste the result below. Keep the keys unique.
%
%  Protect capitals and species names with braces:
%    title = {{Botrytis cinerea} resistance in {L}actuca sativa}
%  otherwise some styles will lower-case them.
% ============================================================


% ---------- THESIS ----------
% TODO: replace the title with the exact one on your title page, and add
% the White Rose eTheses URL (as a url = {...} field) once deposited.
% NOTE: keep "%" comments BETWEEN entries, never inside the braces of one —
% the Typst PDF renderer rejects them.
@phdthesis{kara2026thesis,
  author = {Kara, Mehmet Fatih},
  title  = {Disease resistance to necrotrophic fungal pathogens in lettuce
            ({Lactuca sativa})},
  school = {University of York},
  type   = {PhD thesis},
  address = {York, United Kingdom},
  year   = {2026}
}


% ---------- IN PREPARATION ----------
% Keep "in preparation" items as "unpublished so the style marks
% them properly. Promote to an article entry once accepted.
@unpublished{kara2026lserf1,
  author = {Kara, Mehmet Fatih},
  title  = {{LsERF1}, a lettuce {ERF} transcription factor, alters
            resistance to {Botrytis cinerea} when expressed in
            {Arabidopsis}},
  note   = {Manuscript in preparation},
  year   = {2026}
}


